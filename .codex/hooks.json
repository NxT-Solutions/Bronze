{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/gitnexus/gitnexus-hook.cjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/gitnexus/gitnexus-hook.cjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
