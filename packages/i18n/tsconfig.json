{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["node", "react"]
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*", "locales/**/*.json"],
  "exclude": ["node_modules", "dist"]
}
