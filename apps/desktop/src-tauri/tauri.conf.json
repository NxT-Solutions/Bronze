{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Bronze",
  "version": "0.0.0",
  "identifier": "app.bronze.desktop",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "quick",
        "title": "Bronze",
        "url": "index.html",
        "width": 400,
        "height": 720,
        "minWidth": 320,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "focus": true,
        "devtools": false
      },
      {
        "label": "library",
        "title": "Bronze Library",
        "url": "library.html",
        "width": 720,
        "height": 640,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "devtools": false
      },
      {
        "label": "settings",
        "title": "Bronze Settings",
        "url": "settings.html",
        "width": 640,
        "height": 720,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "devtools": false
      },
      {
        "label": "help",
        "title": "Bronze Help",
        "url": "help.html",
        "width": 640,
        "height": 640,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset: http://asset.localhost",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline' asset: http://asset.localhost",
        "script-src": "'self' 'unsafe-inline' asset: http://asset.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "capabilities": ["quick", "library", "settings", "onboarding", "help"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["models/*"],
    "macOS": {
      "entitlements": "entitlements/macos.release.plist"
    }
  }
}
