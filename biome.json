{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "formatWithErrors": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": { "useSemanticElements": "warn" },
      "complexity": { "noImportantStyles": "warn" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "double" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "files": {
    "includes": [
      "**",
      "!!.claude",
      "!!.agents",
      "!!.opencode",
      "!!_bmad",
      "!!_bmad-output",
      "!!.bmad-loop",
      "!!.hedgehog",
      "!!.cursor",
      "!!.codex",
      "!!.grok",
      "!!hooks",
      "!!vendor-skills",
      "!!apps/desktop/src-tauri"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
